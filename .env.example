# Bu dosyayı kopyalayıp ".env" adıyla kaydedin ve gerçek değerleri girin.
# .env dosyasının kendisi ASLA git'e eklenmemeli (bkz. .gitignore).

# Rastgele ve tahmin edilemez bir anahtar üretmek için terminalde çalıştırın:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uretilen-rastgele-anahtari-yapistirin

# Geliştirme ortamında True, canlı (production) ortamda mutlaka False olmalı.
FLASK_DEBUG=True
